# Optional: provide API keys via environment instead of the OS keychain.
# Name format: HEARTHFORGE_KEY_<PROVIDER_ID in upper case, non-alphanumerics -> _>
# HEARTHFORGE_KEY_OPENROUTER=
# HEARTHFORGE_KEY_GROQ=
# Optional: relocate all app data (settings, indexes, snapshots, audit log)
# HEARTHFORGE_HOME=
